{
  "id": "./",
  "name": "X n O",
  "short_name": "X n O",
  "description": "Tic-tac-toe where you move your marks: place three each, then move one every turn to make a line. Play on one device, the computer, or online.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone"],
  "background_color": "#101011",
  "theme_color": "#101011",
  "categories": ["games", "entertainment"],
  "launch_handler": {"client_mode": ["navigate-existing", "auto"]},
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "screenshots": [
    {"src": "shots/phone-board.webp", "sizes": "1170x2532", "type": "image/webp", "form_factor": "narrow", "label": "Three marks each, then you move one"},
    {"src": "shots/phone-computer.webp", "sizes": "1170x2532", "type": "image/webp", "form_factor": "narrow", "label": "Play the computer on Easy, Medium or Perfect"},
    {"src": "shots/wide-board.webp", "sizes": "1920x1200", "type": "image/webp", "form_factor": "wide", "label": "X n O on a bigger screen"}
  ],
  "shortcuts": [
    {"name": "Play the computer", "short_name": "Computer", "url": "./?mode=ai", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]},
    {"name": "Find a match", "short_name": "Find a match", "url": "./?mode=online&find=1", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]},
    {"name": "Same device", "short_name": "Same device", "url": "./?mode=local", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]}
  ]
